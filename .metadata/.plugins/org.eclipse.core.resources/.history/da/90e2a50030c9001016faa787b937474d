HAL_StatusTypeDef OpenValve(){
	uint8_t flag1=0,flag2=0,flag3=0;
	uint16_t timout=1500;
	time.tick = HAL_GetTick();
	 N20_1_WKUP();
	 N20_2_WKUP();
	N20_1_CW();                                     // n-20 (+ to + and - to -)
	N20_2_ACW();                                     // n-20 (+ to + and - to -)
	while(HAL_GetTick()-time.tick<timout){
		valvevalue();
		if((hal3>1.4f+ 0.01f) &&(!flag1)){
			N20_1_OFF();
			N20_1_SLEEP();
			flag1=1;
		}
		if((hal1>1.4f+ 0.01f)&&(!flag2)){
			N20_2_OFF();
            N20_2_SLEEP();
			flag2=1;
		}
		if(flag1&&flag2){
			return(HAL_OK);
		}

	}
	if (flag1!=1){while((hal3>1.4f)&&(hal3<1.6f) && (flag3==0)){ valvevalue();N20_1_OFF(); if(HAL_GetTick()-(time.tick+timout)<300){flag3=1;}}}
	if (flag2!=1){while((hal1>1.4f)&&(hal1<1.6f)&&(flag3==0)){ valvevalue();N20_2_OFF();if(HAL_GetTick()-(time.tick+timout)<300){flag3=1;}}}
	N20_1_OFF();
	N20_2_OFF();
	N20_1_SLEEP();
	N20_2_SLEEP();
	return(HAL_TIMEOUT);
}
HAL_StatusTypeDef CloseValve(){
	uint8_t flag1=0,flag2=0,flag3=0;
	uint16_t timout=1500;    // to detect valve position
	time.tick = HAL_GetTick();
	N20_1_WKUP();
	N20_2_WKUP();
	N20_1_ACW();
	N20_2_CW();
	while(HAL_GetTick()-time.tick<timout){
		valvevalue();
		if((hal2>1.4f+ 0.01f)&&(!flag2)){      // left pump  .01f
			N20_2_OFF();
			flag2=1;
			N20_2_SLEEP();
						}
		if((hal4>1.4f+ 0.01f)&&(!flag1)){      // Right pump
			N20_1_OFF();
			flag1=1;
			N20_1_SLEEP();
		}
		if(flag1&&flag2){
			return(HAL_OK);
		}
	}
	if (flag1!=1){while((hal4>1.4f)&&(hal4<1.6f) && (flag3==0)){ valvevalue();N20_1_OFF(); if(HAL_GetTick()-(time.tick+timout)<300){flag3=1;}}}
	if (flag2!=1){while((hal2>1.4f)&&(hal2<1.6f)&&(flag3==0)){ valvevalue();N20_2_OFF();if(HAL_GetTick()-(time.tick+timout)<300){flag3=1;}}}
    N20_1_OFF();
	N20_2_OFF();
	N20_1_SLEEP();
	N20_2_SLEEP();
	return(HAL_TIMEOUT);
}
HAL_StatusTypeDef INFLATION(){

//	FAN1_ON();
//	FAN2_ON();
	if(OpenValve()==HAL_TIMEOUT) {
		FAN1_OFF();
		FAN2_OFF();
		return(HAL_TIMEOUT);
	}
	HAL_Delay(1500);//pump running time
	if(CloseValve()==HAL_TIMEOUT) {
		FAN1_OFF();
		FAN2_OFF();
		return(HAL_TIMEOUT);
	}
	FAN1_OFF();
    FAN2_OFF();
	return(HAL_OK);
}
HAL_StatusTypeDef DEFLATION(){
	return(OpenValve());
}

